# 上游真实百炼服务地址(默认阿里云 DashScope,用于 OpenAI 兼容模式 /compatible-mode/v1/*)
UPSTREAM_BASE=https://dashscope.aliyuncs.com

# 原生 DashScope API(/api/v1/*)的上游地址。
# 原生模式按区域/工作空间使用独立域名,例如:
#   北京: https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com
#   美国: https://dashscope-us.aliyuncs.com
# 留空则回退到 UPSTREAM_BASE。
NATIVE_UPSTREAM_BASE=

# 网关监听地址与端口
HOST=0.0.0.0
PORT=8000

# 转发请求超时(秒)。SSE 长连接需要足够大。
REQUEST_TIMEOUT=300

# CORS 白名单来源,逗号分隔。留空则禁用 CORS(纯服务端调用场景)。
# 例: https://internal.example.com,http://localhost:5173
ALLOW_ORIGINS=

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO